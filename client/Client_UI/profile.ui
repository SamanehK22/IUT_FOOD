    <property name="styleSheet">
     <string notr="true">QPushButton {
    background-color: #fb923c;        /* نارنجی گرم */
    color: white;                     /* متن سفید */
    border: 2px solid #f97316;        /* نارنجی پررنگ‌تر */
    border-radius: 12px;              /* گوشه‌های گرد */
    padding: 6px 16px;                /* فضای داخلی */
    font-size: 14px;
    font-weight: 600;
    font-family: 'Segoe UI';
}

QPushButton:hover {
    background-color: #f97316;        /* تیره‌تر موقع هاور */
    border-color: #ea580c;
}

QPushButton:pressed {
    background-color: #c2410c;        /* حالت کلیک‌شده */
    border-color: #9a3412;
}
</string>
