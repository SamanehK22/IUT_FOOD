   <property name="styleSheet">
    <string notr="true">QListWidget {
    background-color: #f7e9e3;
    border: 2px solid #deb6ab;
    border-radius: 12px;
    padding: 6px;
    color: #4b3b40;
    font-family: &quot;B Nazanin&quot;, &quot;Vazir&quot;, &quot;Segoe UI&quot;, sans-serif;
    font-size: 17px;
    font-weight: bold;
}

QListWidget::item {
    background-color: transparent;
    padding: 10px;
    border-radius: 8px;
    margin: 4px;
    transition: all 0.3s ease;
}

QListWidget::item:hover {
    background-color: #f2d4c9;
    color: #3a2b2e;
}

QListWidget::item:selected {
    background-color: #e4bfb3;
    color: white;
    font-weight: 900;
    border: 1px solid #d19a91;
}

/* --- Scrollbar عمودی --- */
QScrollBar:vertical {
    background: #f7e9e3;
    width: 12px;
    margin: 2px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #d8a29d;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #c98682;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, 
QScrollBar::sub-page:vertical {
    background: none;
}
</string>
